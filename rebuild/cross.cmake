set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(T "$ENV{BP_ROOT}/win-llvm")
set(S "$ENV{BP_ROOT}/winsdk")
set(CMAKE_C_COMPILER "${T}/clang-cl")
set(CMAKE_CXX_COMPILER "${T}/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_AR /usr/bin/llvm-lib-19)
set(CMAKE_MT /usr/bin/llvm-mt-19)
set(CMAKE_LINKER /usr/bin/lld-link-19)
set(CMAKE_RC_COMPILER "${T}/res")
set(CMAKE_C_FLAGS_INIT "/imsvc${S}/crt/include /imsvc${S}/sdk/include/ucrt /imsvc${S}/sdk/include/shared /imsvc${S}/sdk/include/um /imsvc${S}/sdk/include/winrt /utf-8 -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/libpath:${S}/crt/lib/x86_64 /libpath:${S}/sdk/lib/ucrt/x86_64 /libpath:${S}/sdk/lib/um/x86_64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${S}" "${S}/sdk")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
