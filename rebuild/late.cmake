function(bp_xwin_finish)
 foreach(t Common Core PPSSPPWindows)
  if(TARGET ${t})
   target_precompile_headers(${t} PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:<vector$<ANGLE-R>>" "$<$<COMPILE_LANGUAGE:CXX>:<string$<ANGLE-R>>" "$<$<COMPILE_LANGUAGE:CXX>:<map$<ANGLE-R>>" "$<$<COMPILE_LANGUAGE:CXX>:<algorithm$<ANGLE-R>>")
  endif()
 endforeach()
 if(TARGET PPSSPPWindows)
  target_link_libraries(PPSSPPWindows mmdevapi wbemuuid winhttp mfuuid shlwapi winmm ws2_32 dxguid opengl32 glu32 iphlpapi)
 endif()
endfunction()
cmake_language(DEFER CALL bp_xwin_finish)
