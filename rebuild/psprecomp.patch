+/* Only the thread that owns a callback may drain its pending notifications.
+ * Notifications coalesce, keeping the most recent argument and a count. */
+static void hle_NotifyCallback(void) {
+    for (int i=0;i<MAX_CBS;i++) {
+        psp_callback *c=&g_cb[i];
+        if (c->used && c->uid==psp_arg(0)) {
+            if(c->pending!=0xffffffffu) c->pending++;
+            c->notify_arg=psp_arg(1);psp_ret(0);return;
+        }
+    }
+    psp_ret(SCE_KERNEL_ERROR_UNKNOWN_UID);
+}
+static void hle_CheckCallback(void) {
+    uint32_t ran=0, owner=g_current?g_current->uid:0;
+    for(int i=0;i<MAX_CBS;i++) {
+        psp_callback *c=&g_cb[i];
+        if (!c->used || !c->pending || c->owner_id!=owner) continue;
+        psp_cpu_state saved=psp_cpu;
+        psp_cpu.r[PSP_REG_A0]=c->pending;psp_cpu.r[PSP_REG_A1]=c->notify_arg;
+        psp_cpu.r[PSP_REG_A2]=c->arg;psp_cpu.r[PSP_REG_RA]=0;
+        c->pending=0;psp_dispatch(c->func);
+        if(psp_cpu.r[PSP_REG_V0])c->used=0;
+        psp_cpu=saved;ran=1;
+    }
+    psp_ret(ran);
+}
 void psp_threadman_register(void) {
+    psp_hle_register(0x349D6D6C, "ThreadManForUser", "sceKernelCheckCallback", hle_CheckCallback);
