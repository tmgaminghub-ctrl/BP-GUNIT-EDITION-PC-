+static void test_pending_callbacks(void) {
+    const uint32_t entry=0x08801100u, name=0x08803300u;
+    psp_threadman_reset();psp_register(entry,fake_cb);
+    psp_mem_write_block(name,"cb",3);
+    uint32_t id=call(psp_nid("sceKernelCreateCallback"),name,entry,77,0);
+    psp_cpu.r[PSP_REG_S0]=9;
+    CHECK(call(psp_nid("sceKernelCheckCallback"),0,0,0,0)==0 && !cb_seen, "empty callback queue");
+    CHECK(call(psp_nid("sceKernelNotifyCallback"),id,11,0,0)==0,"first callback notify");
+    CHECK(call(psp_nid("sceKernelNotifyCallback"),id,22,0,0)==0,"second callback notify");
+    CHECK(call(psp_nid("sceKernelCheckCallback"),0,0,0,0)==1,"callback ran in owning thread");
+    CHECK(cb_seen==1 && cb_n==2 && cb_latest==22 && cb_user==77,"coalesced count and arguments");
+    CHECK(psp_cpu.r[PSP_REG_S0]==9,"guest callback preserved caller registers");
+    CHECK(call(psp_nid("sceKernelCheckCallback"),0,0,0,0)==0,"delivery drains notifications");
+    CHECK(call(psp_nid("sceKernelNotifyCallback"),0xdead,1,0,0)==SCE_KERNEL_ERROR_UNKNOWN_UID,"refuse bad callback id");
