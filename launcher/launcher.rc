#include <winver.h>
1 ICON "art/bulletproof.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unofficial fan player"
            VALUE "FileDescription", "Bulletproof PC campaign launcher"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BulletproofPC"
            VALUE "OriginalFilename", "Play Bulletproof.exe"
            VALUE "ProductName", "50 Cent: Bulletproof - G-Unit Edition PC player"
            VALUE "LegalCopyright", "Unofficial; game data belongs to its owners"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
